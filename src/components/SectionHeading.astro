---
type Props = {
  eyebrow?: string;
  title: string;
  href?: string;
  linkLabel?: string;
};

const { eyebrow, title, href, linkLabel } = Astro.props;
---

<div class="section-heading">
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
  </div>
  {href && linkLabel && <a class="text-link" href={href}>{linkLabel}</a>}
</div>
