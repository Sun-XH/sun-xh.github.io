---
import type { EducationItem } from "../data/site";

type Props = {
  items: EducationItem[];
};

const { items } = Astro.props;
---

<div class="education-list">
  {items.map((item) => (
    <article class="education-item">
      <img src={item.logo} alt={item.logoAlt} loading="lazy" />
      <div>
        <h3>{item.degree}</h3>
        <p>{item.period}</p>
        <p>Advisor: <a href={item.advisor.href} target="_blank" rel="noreferrer">{item.advisor.label}</a></p>
      </div>
    </article>
  ))}
</div>
